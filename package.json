{
  "name": "nimbus-scheduler",
  "version": "2.0.0",
  "private": true,
  "description": "A small resource-aware distributed task scheduler: master, workers and a realtime dashboard",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "mini-scheduler/master",
    "mini-scheduler/worker",
    "mini-scheduler-ui"
  ],
  "scripts": {
    "dev:master": "npm run dev --workspace mini-scheduler-master",
    "dev:worker": "npm run dev --workspace mini-scheduler-worker",
    "dev:ui": "npm run dev --workspace mini-scheduler-ui",
    "build": "npm run build --workspace mini-scheduler-ui",
    "test": "npm run test --workspace mini-scheduler-master && npm run test --workspace mini-scheduler-worker",
    "typecheck": "npm run typecheck --workspace mini-scheduler-ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.69.0"
  }
}
