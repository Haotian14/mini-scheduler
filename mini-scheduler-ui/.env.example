# Master REST + WebSocket origin
VITE_API_URL=http://127.0.0.1:3000

# Shared secret, must match SCHEDULER_TOKEN on the master.
# Leave empty for local development with an unauthenticated master.
VITE_SCHEDULER_TOKEN=

# Demo mode: run the scheduler against a simulated fleet in the browser,
# with no master to connect to. The GitHub Pages build sets this.
VITE_DEMO=false
