# --- Security -------------------------------------------------------------
# Shared secret for the worker callbacks and the task API. Required when
# NODE_ENV=production; without it the API can execute shell commands for anyone
# who can reach the port.
SCHEDULER_TOKEN=

# Browser origins allowed to call the API. "*" disables the check entirely.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Networking -----------------------------------------------------------
PORT=3000

# --- Timings (milliseconds) ----------------------------------------------
HEARTBEAT_TIMEOUT_MS=6000    # silence after which a worker is declared OFFLINE
SWEEP_INTERVAL_MS=1000       # how often offline / overdue detection runs
BROADCAST_INTERVAL_MS=100    # WebSocket event coalescing window
TASK_TIMEOUT_MS=1800000      # wall-clock budget for one task attempt
RETRY_COOLDOWN_MS=10000      # how long a failing worker is skipped for a task
AGING_MS=15000               # wait after which a pending task blocks the queue

# --- Limits ---------------------------------------------------------------
MAX_ATTEMPTS=3               # attempts per task, including the first
TASK_RETENTION=500           # finished tasks kept in memory
LOG_RETENTION=5000           # log lines kept per task
