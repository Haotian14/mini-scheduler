# --- Security -------------------------------------------------------------
# Must match the master's SCHEDULER_TOKEN. Required when NODE_ENV=production:
# /run executes shell commands on this machine.
SCHEDULER_TOKEN=

# --- Identity and capacity ------------------------------------------------
WORKER_ID=                   # defaults to a random id
WORKER_HOST=127.0.0.1        # the address the master dials back on
WORKER_PORT=4001
MASTER_URL=http://127.0.0.1:3000
CPU_TOTAL=4                  # advertised capacity, not measured from the host
MEM_TOTAL=8

# --- Timings (milliseconds) ----------------------------------------------
HEARTBEAT_INTERVAL_MS=2000
LOG_FLUSH_INTERVAL_MS=100    # output is batched until this or LOG_FLUSH_BYTES
LOG_FLUSH_BYTES=4096
LOG_BUFFER_LIMIT=2000        # lines buffered before output starts being dropped
REPORT_RETRIES=6             # retries for reports the master must receive
REPORT_BACKOFF_MS=250
REQUEST_TIMEOUT_MS=5000
KILL_GRACE_MS=3000           # SIGTERM to SIGKILL grace period on cancellation
